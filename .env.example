# Required on the server. Never expose this value to browser code.
OPENAI_API_KEY=

# Optional secret used to make the per-user OpenAI safety identifier stable.
# On Vercel, set this to a long random value.
SAFETY_HASH_SALT=

# P1 is available by default. Set to "false" to disable diarization routes.
ENABLE_DIARIZATION=true
